# Task 2 - MCP security gateway
MCP_DOWNSTREAM_URL=http://127.0.0.1:9100/mcp
MCP_GATEWAY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
MCP_GATEWAY_JWT_AUDIENCE=mcp-gateway
MCP_GATEWAY_JWT_ISSUER=auth.example.local
MCP_FILTER_TOOLS_LIST=false

# Task 3 - streaming PII guardrail
LLM_UPSTREAM_URL=http://127.0.0.1:9200/v1/chat/completions
LLM_UPSTREAM_API_KEY=

# Task 4 - rate limiter and model router
ROUTER_DB_PATH=data/llm_gateway.db
ROUTER_TOKENS_PER_MINUTE=50000
PRIMARY_MODEL_URL=http://127.0.0.1:9301/v1/chat/completions
PRIMARY_MODEL_API_KEY=
PRIMARY_TIMEOUT_SECONDS=3.0
SECONDARY_MODEL_URL=http://127.0.0.1:9302/v1/chat/completions
SECONDARY_MODEL_API_KEY=
SECONDARY_TIMEOUT_SECONDS=10
